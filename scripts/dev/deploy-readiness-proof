#!/usr/bin/env python3
"""Simulated deployment control plane; no live services or model traffic.

Runs the real deploy.sh against disposable processes. curl supplies labelled
status scenarios and sleep shortens polling; kill and process exit are real.
"""
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile
import threading

ROOT = Path(__file__).resolve().parents[2]
PROCESS = '''#!/usr/bin/env python3
import os, signal, sys, time
from pathlib import Path
root = Path(os.environ["PROOF_DIRECTORY"])
if len(sys.argv) > 1 and sys.argv[1] == "print-revision":
    print("target")
    sys.exit(0)
kind = os.environ.get("PROOF_PROCESS", "bridge")
(root / (kind + ".pid")).write_text(str(os.getpid()))
def stop(signum, frame):
    (root / (kind + ".terminated")).write_text("yes")
    sys.exit(0)
signal.signal(signal.SIGTERM, stop)
while True:
    time.sleep(0.05)
'''
CURL = '''#!/usr/bin/env python3
import json, os, sys, time
from pathlib import Path
root = Path(os.environ["PROOF_DIRECTORY"])
scenario = os.environ["PROOF_SCENARIO"]
count_path = root / "poll-count"
count = int(count_path.read_text()) if count_path.exists() else 0
count_path.write_text(str(count + 1))
if count == 0:
    kind, revision = "old", "old"
else:
    for _ in range(100):
        if (root / "bridge.pid").exists(): break
        time.sleep(0.005)
    if not (root / "old.terminated").exists():
        kind, revision = "bridge", "wrong" if scenario == "wrong-bridge" else "target"
    elif scenario == "empty-successor":
        sys.exit(22)
    elif scenario == "failed-successor":
        kind, revision = "bridge", "target"
    else:
        kind, revision = "successor", "wrong" if scenario == "wrong-successor" else "target"
print(json.dumps({"revision": revision, "pid": int((root / (kind + ".pid")).read_text())}, separators=(",", ":")))
'''


def executable(path, text):
    path.write_text(text)
    path.chmod(0o755)


def run_scenario(scenario, mode="new"):
    with tempfile.TemporaryDirectory(prefix="codex-switch-deploy-contract-") as temporary:
        directory = Path(temporary)
        tools = directory / "tools"
        tools.mkdir()
        executable(tools / "curl", CURL)
        executable(tools / "sleep", "#!/bin/sh\n/bin/sleep 0.005\n")
        stable = directory / "stable"
        candidate = directory / "candidate"
        executable(stable, PROCESS + "# original stable artifact\n")
        executable(candidate, PROCESS)
        previous = directory / "stable.previous"
        executable(previous, PROCESS + "# previous artifact\n")
        (directory / "client-capability").write_text("simulation-only")
        environment = dict(os.environ, PROOF_DIRECTORY=temporary, PROOF_SCENARIO=scenario,
                           PATH=str(tools) + os.pathsep + os.environ["PATH"])
        processes = []
        for kind in ("old", "successor"):
            process = subprocess.Popen([str(stable), "serve"], env=dict(environment, PROOF_PROCESS=kind))
            processes.append(process)
            threading.Thread(target=process.wait, daemon=True).start()
        try:
            for process_kind in ("old", "successor"):
                for _ in range(200):
                    if (directory / (process_kind + ".pid")).exists():
                        break
                    threading.Event().wait(0.005)
                else:
                    raise RuntimeError("simulation process did not start")
            command = ["/bin/sh", str(ROOT / "deploy/deploy.sh"), mode]
            if mode == "new":
                command.append(str(candidate))
            result = subprocess.run(command + ["--stable", str(stable), "--data", temporary, "--listen", "127.0.0.1:1"],
                                    env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    text=True, timeout=25)
            # A terminated bridge has already been waited for by deploy.sh.
            old_stopped = (directory / "old.terminated").exists()
            bridge_stopped = (directory / "bridge.terminated").exists()
            expected = (False, True, False) if scenario == "wrong-bridge" else (
                (True, True, True) if scenario == "ready-successor" else (True, False, False))
            actual = (old_stopped, bridge_stopped, result.returncode == 0)
            stable_restored = stable.read_text().endswith("# original stable artifact\n")
            passed = actual == expected and (scenario != "wrong-bridge" or stable_restored)
            if mode == "back":
                passed = passed and previous.read_text().endswith("# previous artifact\n")
            print(json.dumps({"simulation": scenario, "mode": mode, "passed": passed, "stable_restored": stable_restored, "old_terminated": old_stopped,
                              "bridge_terminated": bridge_stopped, "deployment_succeeded": result.returncode == 0}), flush=True)
            return passed
        finally:
            # These PIDs were created in this temporary proof directory only.
            for kind in ("old", "successor", "bridge"):
                pid_file = directory / (kind + ".pid")
                if pid_file.exists():
                    try:
                        os.kill(int(pid_file.read_text()), signal.SIGTERM)
                    except ProcessLookupError:
                        pass
            for process in processes:
                process.wait(timeout=3)


if __name__ == "__main__":
    results = [run_scenario(scenario) for scenario in (
        "wrong-bridge", "failed-successor", "empty-successor", "wrong-successor", "ready-successor")]
    results.extend(run_scenario(scenario, "back") for scenario in ("wrong-bridge", "ready-successor"))
    raise SystemExit(0 if all(results) else 1)
