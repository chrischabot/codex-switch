#!/usr/bin/env python3
"""Isolated official-Codex continuity exercise. Private state never leaves .project-private."""
import argparse
import base64
import datetime
import json
import hashlib
import os
from pathlib import Path
import re
import plistlib
import signal
import socket
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parents[2]
ROOT = Path(os.environ.get('CODEX_SWITCH_RIG_ROOT', str(REPO / '.project-private/continuity-rig'))).expanduser().resolve()
CODEX = '/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex'
PI_PLACEHOLDER_KEY = 'eyJhbGciOiJub25lIn0.eyJodHRwczovL2FwaS5vcGVuYWkuY29tL2F1dGgiOnsiY2hhdGdwdF9hY2NvdW50X2lkIjoiY29kZXgtc3dpdGNoIn19.codex-switch'


def supervisor_target():
    label = 'dev.codex-switch.rig.' + hashlib.sha256(str(ROOT).encode()).hexdigest()[:12]
    return f'gui/{os.getuid()}/{label}'


def supervisor_running():
    return subprocess.run(['launchctl', 'print', supervisor_target()], capture_output=True).returncode == 0


def proxy_processes():
    processes = subprocess.run(['ps', '-axo', 'pid=,stat=,command='], capture_output=True, text=True, check=True)
    binary = str(ROOT / 'codex-switch') + ' serve '
    owned = []
    for line in processes.stdout.splitlines():
        fields = line.strip().split(None, 2)
        if len(fields) == 3 and not fields[1].startswith('Z') and fields[2].startswith(binary):
            owned.append(int(fields[0]))
    return owned


def environment():
    env = {k: v for k, v in os.environ.items() if not k.startswith(('CODEX_', 'OPENAI_'))}
    env.update(CODEX_HOME=str(ROOT / 'home'), CODEX_SWITCH_DATA_DIR=str(ROOT / 'data'), CODEX_SWITCH_RIG_ROOT=str(ROOT))
    return env


def owned_process(kind):
    path = ROOT / (kind + '.pid')
    if not path.exists():
        return None
    pid = int(path.read_text())
    process = subprocess.run(['ps', '-p', str(pid), '-o', 'stat=', '-o', 'command='], capture_output=True, text=True)
    binary = ROOT / ('codex-switch' if kind == 'proxy' else 'upstream')
    if process.returncode or not process.stdout.strip():
        return None
    process_state, command = process.stdout.strip().split(None, 1)
    if process_state.startswith('Z'):
        return None
    if not command.startswith(str(binary) + ' '):
        raise RuntimeError(f'{kind} PID now belongs to a different process')
    return pid


def require_stopped():
    if supervisor_running() or proxy_processes() or owned_process('upstream'):
        raise RuntimeError('Stop the isolated rig before preparing or starting it again')


def stop():
    # Proxy SIGTERM drains admitted work; the gateway remains until it exits.
    if supervisor_running():
        subprocess.run(['launchctl', 'bootout', supervisor_target()], check=True)
    for pid in proxy_processes():
        os.kill(pid, signal.SIGTERM)
    while proxy_processes():
        time.sleep(.2)
    pid = owned_process('upstream')
    if pid:
        os.kill(pid, signal.SIGTERM)
        while owned_process('upstream'):
            time.sleep(.2)
    print('Isolated rig stopped.')


def prepare():
    require_stopped()
    os.umask(0o077)
    for part in ('home', 'work', 'data', 'logs'):
        (ROOT / part).mkdir(parents=True, exist_ok=True)
    source = Path.home() / 'Library/Application Support/codex-switch'
    for account in sorted(source.glob('account-*/auth.json')):
        auth = json.loads(account.read_text())
        claims = json.loads(base64.urlsafe_b64decode(auth['tokens']['access_token'].split('.')[1] + '==='))
        if claims['exp'] < time.time() + 3600:
            raise RuntimeError(f'{account.parent.name} needs a fresh access token before isolated testing')
        auth['tokens']['refresh_token'] = 'isolated-rig-no-refresh'
        auth['last_refresh'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        target = ROOT / 'data' / account.parent.name
        target.mkdir(exist_ok=True)
        (target / 'auth.json').write_text(json.dumps(auth))
        if account.parent.name == 'account-1':
            (ROOT / 'home/auth.json').write_text(json.dumps(auth))
    (ROOT / 'pi').mkdir(exist_ok=True)
    (ROOT / 'control').write_text('')
    (ROOT / 'work/input.txt').write_text('3\n5\n8\n')
    subprocess.run(['git', 'init', '-q', str(ROOT / 'work')], check=True)
    print('Prepared isolated homes; copied access tokens only, refresh tokens replaced.')


def build_proxy(destination):
    subprocess.run(['devenv', 'shell', '--', str(REPO / 'scripts/dev/build-proxy'), str(destination)], cwd=REPO, check=True)


def start(supervised=False):
    require_stopped()
    if not (ROOT / 'build-state').exists() or (ROOT / 'build-state').read_text() != 'ready':
        raise RuntimeError('Build this rig successfully before starting it')
    env = environment()
    for name in ('upstream.log', 'proxy.log'):
        path = ROOT / 'logs' / name
        if path.exists():
            path.rename(path.with_name(str(time.time_ns()) + '-' + name))
    gateway_log = (ROOT / 'logs/upstream.log').open('w')
    gateway = subprocess.Popen([str(ROOT / 'upstream'), '--data-dir', str(ROOT / 'data'), '--control', str(ROOT / 'control')], env=env, stdout=gateway_log, stderr=gateway_log, start_new_session=True)
    (ROOT / 'upstream.pid').write_text(str(gateway.pid))
    for _ in range(100):
        content = (ROOT / 'logs/upstream.log').read_text()
        match = re.search(r'http://127\.0\.0\.1:\d+', content)
        if match:
            break
        if gateway.poll() is not None:
            raise RuntimeError('gateway exited; inspect private upstream.log')
        time.sleep(.1)
    else:
        raise RuntimeError('gateway did not announce listener')
    env['CODEX_SWITCH_UPSTREAM_ORIGIN'] = match[0]
    proxy_log = (ROOT / 'logs/proxy.log').open('w')
    if supervised:
        with socket.socket() as reservation:
            reservation.bind(('127.0.0.1', 0))
            listen = f'127.0.0.1:{reservation.getsockname()[1]}'
        (ROOT / 'listen').write_text(listen)
        (ROOT / 'upstream-origin').write_text(env['CODEX_SWITCH_UPSTREAM_ORIGIN'])
        configuration = {
            'Label': supervisor_target().split('/')[-1],
            'ProgramArguments': [str(ROOT / 'codex-switch'), 'serve', '--listen', listen],
            'EnvironmentVariables': {name: env[name] for name in ('CODEX_SWITCH_DATA_DIR', 'CODEX_SWITCH_UPSTREAM_ORIGIN')},
            'KeepAlive': True,
            'RunAtLoad': True,
            'ExitTimeOut': 0,
            'StandardOutPath': str(ROOT / 'logs/proxy.log'),
            'StandardErrorPath': str(ROOT / 'logs/proxy.log'),
        }
        plist = ROOT / 'supervisor.plist'
        plist.write_bytes(plistlib.dumps(configuration))
        subprocess.run(['launchctl', 'bootstrap', f'gui/{os.getuid()}', str(plist)], check=True)
        proxy = None
    else:
        proxy = subprocess.Popen([str(ROOT / 'codex-switch'), 'serve', '--listen', '127.0.0.1:0'], env=env, stdout=proxy_log, stderr=proxy_log, start_new_session=True)
        (ROOT / 'proxy.pid').write_text(str(proxy.pid))
    for _ in range(100):
        match = re.search(r'http://127\.0\.0\.1:\d+', (ROOT / 'logs/proxy.log').read_text())
        if match:
            break
        if proxy is not None and proxy.poll() is not None:
            raise RuntimeError('proxy exited; inspect logs/proxy.log and data/proxy.log')
        time.sleep(.1)
    else:
        raise RuntimeError('proxy did not announce listener')
    capability = (ROOT / 'data/client-capability').read_text()
    base = match[0] + '/client/' + capability + '/backend-api/codex'
    (ROOT / 'home/config.toml').write_text(f'openai_base_url = "{base}"\nmodel = "gpt-5.6-luna"\nmodel_reasoning_effort = "low"\nservice_tier = "default"\ncli_auth_credentials_store = "file"\n[analytics]\nenabled = false\n')
    # Pi has no ChatGPT login of its own: it needs only a JWT-shaped key carrying a
    # chatgpt_account_id claim; the proxy replaces Authorization and ChatGPT-Account-ID.
    (ROOT / 'pi/models.json').write_text(json.dumps({'providers': {'openai-codex': {'baseUrl': base, 'apiKey': PI_PLACEHOLDER_KEY}}}))
    print(f'Isolated proxy and upstream running. Logs: {ROOT / "logs"}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['prepare', 'build', 'build-candidate', 'start', 'start-supervised', 'stop', 'exec', 'resume', 'goal', 'pi', 'deploy', 'rollback'])
    parser.add_argument('prompt', nargs='?', default='Read input.txt using a tool. Calculate its sum and write the sum to result.txt. Report the result.')
    args = parser.parse_args()
    if args.action == 'prepare':
        prepare()
    elif args.action == 'build':
        require_stopped()
        (ROOT / 'build-state').write_text('building')
        build_proxy(ROOT / 'codex-switch')
        subprocess.run(['devenv', 'shell', '--', 'go', 'build', '-o', str(ROOT / 'upstream'), './scripts/dev/continuity-upstream'], cwd=REPO, check=True)
        (ROOT / 'build-state').write_text('ready')
    elif args.action == 'build-candidate':
        build_proxy(ROOT / 'candidate')
    elif args.action in ('start', 'start-supervised'):
        start(supervised=args.action == 'start-supervised')
    elif args.action in ('deploy', 'rollback'):
        if not supervisor_running():
            raise RuntimeError('Start this rig with start-supervised before deployment')
        env = environment()
        env['CODEX_SWITCH_UPSTREAM_ORIGIN'] = (ROOT / 'upstream-origin').read_text()
        command = [str(REPO / 'deploy/deploy.sh')]
        command += ['new', str(Path(args.prompt).resolve())] if args.action == 'deploy' else ['back']
        command += ['--stable', str(ROOT / 'codex-switch'), '--data', str(ROOT / 'data'), '--listen', (ROOT / 'listen').read_text()]
        raise SystemExit(subprocess.call(command, env=env))
    elif args.action == 'stop':
        stop()
    elif args.action == 'pi':
        env = environment()
        env['PI_CODING_AGENT_DIR'] = str(ROOT / 'pi')
        command = ['pi', '--provider', 'openai-codex', '--model', 'gpt-6-luna:low', '--no-session', '-p', args.prompt]
        # Pi -p reads stdin to EOF whenever it is not a TTY; an inherited open pipe hangs it.
        raise SystemExit(subprocess.call(command, cwd=ROOT / 'work', env=env, stdin=subprocess.DEVNULL))
    elif args.action == 'goal':
        raise SystemExit(subprocess.call([sys.executable, str(REPO / 'scripts/dev/continuity-goal.py')], env=environment()))
    else:
        command = [CODEX, 'exec']
        if args.action == 'resume':
            command += ['resume', '--last']
        command += ['--json', '--sandbox', 'workspace-write', '--skip-git-repo-check', args.prompt] if args.action == 'exec' else ['--json', '--skip-git-repo-check', args.prompt]
        raise SystemExit(subprocess.call(command, cwd=ROOT / 'work', env=environment()))


if __name__ == '__main__':
    main()
