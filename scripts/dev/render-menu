#!/bin/sh
# Render every panel state, light and dark, without opening a window.
set -eu
if [ "$#" -ne 2 ]; then
    echo "usage: scripts/dev/render-menu SNAPSHOT.pb OUTPUT_DIRECTORY" >&2
    exit 2
fi
repository=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
snapshot=$(cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
mkdir -p -- "$2"
output=$(cd -- "$2" && pwd)
filter=PanelRenderTests/testRenderRealSnapshotWithoutOpeningMenu
CODEX_SWITCH_RENDER_SNAPSHOT="$snapshot" CODEX_SWITCH_RENDER_OUTPUT="$output" \
    swift test --build-system native --package-path "$repository/macos/CodexSwitchMenu" \
    --filter "$filter"
