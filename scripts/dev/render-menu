#!/bin/sh
# Render the current panel or one-view design studies without opening a window.
set -eu
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "usage: scripts/dev/render-menu SNAPSHOT.pb OUTPUT_DIRECTORY [one-view]" >&2
    exit 2
fi
repository=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
snapshot=$(cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
mkdir -p -- "$2"
output=$(cd -- "$2" && pwd)
filter=PanelRenderTests/testRenderRealSnapshotWithoutOpeningMenu
if [ "${3:-}" = one-view ]; then
    filter=OneViewDesignRenderTests/testRenderOneViewDesigns
elif [ "$#" -eq 3 ]; then
    echo "unknown render arrangement: $3" >&2
    exit 2
fi
CODEX_SWITCH_RENDER_SNAPSHOT="$snapshot" CODEX_SWITCH_RENDER_OUTPUT="$output" \
    swift test --build-system native --package-path "$repository/macos/CodexSwitchMenu" \
    --filter "$filter"
