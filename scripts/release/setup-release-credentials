#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

create_sparkle_key=0
case "${1:-}" in
  --create-sparkle-key) [[ $# -eq 1 ]] || exit 2; create_sparkle_key=1 ;;
  "") ;;
  *) echo "usage: scripts/release/setup-release-credentials [--create-sparkle-key]" >&2; exit 2 ;;
esac
require_commands openssl xcrun xxd
require_notary_credentials
mkdir -p "$release_config"
chmod 700 "$release_config"
if [[ ! -e "$sparkle_private_key" ]]; then
  [[ "$create_sparkle_key" -eq 1 ]] || fail "restore the private key, or use --create-sparkle-key before the first public release"
  [[ ! -e "$sparkle_public_key_file" ]] || fail "a public key already exists; restore its private key from backup"
  (umask 177; openssl rand -base64 32 > "$sparkle_private_key")
fi
chmod 600 "$sparkle_private_key"
derive_sparkle_public_key
if [[ -e "$sparkle_public_key_file" ]]; then
  [[ "$(tr -d '[:space:]' < "$sparkle_public_key_file")" == "$derived_sparkle_public_key" ]] || fail "private key does not match deploy/SparklePublicKey"
else
  printf '%s\n' "$derived_sparkle_public_key" > "$sparkle_public_key_file"
  echo "Commit deploy/SparklePublicKey before preparing a release."
fi
echo "Release credentials are ready. Back up the private Sparkle key in $release_config."
